{
  "name": "cloudflare-pages-d1-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev public --d1 DB=shop-db --persist-to=.wrangler/state",
    "build": "node scripts/verify-pages-build.mjs",
    "deploy": "wrangler pages deploy public",
    "db:migrate:local": "wrangler d1 migrations apply shop-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply shop-db --remote",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.21.0"
  }
}
